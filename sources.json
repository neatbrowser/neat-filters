{
  "uAssets": {
    "repo": "https://github.com/uBlockOrigin/uAssets",
    "rawBase": "https://raw.githubusercontent.com/uBlockOrigin/uAssets"
  },
  "uBlock": {
    "repo": "https://github.com/gorhill/uBlock"
  },
  "braveResources": {
    "repo": "https://github.com/brave/adblock-resources",
    "rawBase": "https://raw.githubusercontent.com/brave/adblock-resources",
    "path": "dist/resources.json"
  },
  "env": {
    "ext_ublock": true,
    "ext_ubol": false,
    "ext_devbuild": false,
    "env_devbuild": false,
    "env_chromium": true,
    "env_edge": false,
    "env_firefox": false,
    "env_legacy": false,
    "env_mobile": false,
    "env_mv3": false,
    "env_safari": false,
    "cap_html_filtering": false,
    "cap_user_stylesheet": true,
    "false": false,
    "ext_abp": false,
    "adguard": false
  },
  "lists": [
    {
      "name": "ubo-resource-abuse.txt",
      "title": "uBlock filters \u2013 Resource abuse",
      "path": "filters/resource-abuse.txt",
      "trusted": true,
      "minRules": 10
    }
  ],
  "uboAssets": {
    "_comment": "Every filter list of uBlock Origin's assets.json (pinned uBlock commit) except those named in exclude. This is the set a person gets by ticking all lists in uBO except the ones below.",
    "exclude": [
      "ublock-experimental",
      "adguard-generic",
      "adguard-mobile",
      "adguard-spyware-url",
      "block-lan",
      "curben-phishing",
      "dpollock-0"
    ],
    "required": [
      "ublock-filters",
      "ublock-badware",
      "ublock-privacy",
      "ublock-unbreak",
      "ublock-quick-fixes",
      "easylist",
      "easyprivacy"
    ],
    "minRules": {
      "ublock-filters": 5000,
      "ublock-badware": 500,
      "ublock-privacy": 500,
      "ublock-unbreak": 500,
      "ublock-quick-fixes": 100,
      "easylist": 20000,
      "easyprivacy": 10000,
      "plowe-0": 2000,
      "urlhaus-1": 5000
    }
  },
  "popups": {
    "name": "popups.txt",
    "title": "Popup rules (converted from $popup and $popunder)",
    "minRules": 1000
  },
  "sanity": {
    "maxRuleDropRatio": 0.3,
    "optionalDropRatio": 0.5
  },
  "excludeResources": [
    "google-ima-dai.js"
  ]
}
